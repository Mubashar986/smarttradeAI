# ============================================================
# SmartTradeAI C2 Engine - Environment Variables
# ============================================================
# Copy this file to .env and fill in your API keys.
# At least ONE LLM provider key is required.
# ============================================================

# --- LLM Provider Keys (multi-provider support) ---

# Select provider explicitly when possible.
# Supported values: groq, gemini, openai, anthropic, xai
LLM_PROVIDER=groq

# Option 1: Groq (free-tier testing)
# Sign up at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
CLAW_MODEL=llama-3.3-70b-versatile

# Option 2: Gemini (future-ready)
# Sign up at https://ai.google.dev
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# CLAW_MODEL=gemini-2.5-flash

# Option 3: Anthropic Claude (production)
# Sign up at https://console.anthropic.com
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# CLAW_MODEL=claude-sonnet-4-6

# Option 4: OpenAI (alternative)
# Sign up at https://platform.openai.com
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_NATIVE_KEY=sk-your-openai-key-here
# CLAW_MODEL=gpt-4o

# Backward-compatible alias accepted by the runtime:
# OPENAI_API_BASE=https://api.openai.com/v1

# --- Engine Config ---
CLAW_MAX_TOKENS=512
CLAW_TEMPERATURE=0.2
CLAW_MAX_TURN_ITERATIONS=8

# --- Optional JWT auth for protected /v1 routes ---
# If unset, the JWT middleware stays disabled for local/dev use.
# C2_JWT_SECRET=replace-with-a-long-random-secret
# C2_JWT_ISSUER=smarttrade-api
# C2_JWT_AUDIENCE=smarttrade-ui

# --- Pinecone (Vector Search for RAG) ---
# Sign up at https://www.pinecone.io
# PINECONE_API_KEY=your-pinecone-key
# PINECONE_INDEX=mql5-docs
# PINECONE_NAMESPACE=mql5_templates
