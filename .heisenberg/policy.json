{
  "$schema": "./schemas/task-manifest.schema.json",
  "version": "3.0.0",
  "mode": "guarded",
  "artifact_root": ".heisenberg/artifacts",
  "task_root": ".heisenberg/tasks",
  "receipt_root": ".heisenberg/receipts",
  "gates": {
    "require_task_manifest_for_product_edits": true,
    "require_planning_artifact_before_product_edits": true,
    "block_destructive_git_commands": true,
    "require_receipt_before_completion": true
  },
  "capabilities": {
    "graperoot": {
      "required_by_default": false,
      "mcp_url": "http://127.0.0.1:8080/mcp",
      "expected_tools": [
        "graph_retrieve",
        "graph_read",
        "graph_neighbors",
        "graph_impact",
        "graph_continue",
        "graph_register_edit",
        "graph_add_memory"
      ]
    }
  },
  "enforcement_levels": {
    "advisory": "Instructions and validation only.",
    "guarded": "Native hooks may block local edits when supported.",
    "enforced": "CI and protected branches validate policy before merge."
  }
}
