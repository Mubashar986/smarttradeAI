        <mxCell id="note1" value="&lt;b&gt;FR01-FR04&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FR01&lt;/b&gt;&lt;br&gt;FR01-01 Text input for natural-language trading constraints&lt;br&gt;FR01-02 Validate completeness and clarity&lt;br&gt;FR01-03 Example templates for common strategies&lt;br&gt;&lt;br&gt;&lt;b&gt;FR02&lt;/b&gt;&lt;br&gt;FR02-01 Queue tasks in Redis with unique IDs&lt;br&gt;FR02-02 Real-time task status updates&lt;br&gt;FR02-03 Task history for user reference&lt;br&gt;&lt;br&gt;&lt;b&gt;FR03&lt;/b&gt;&lt;br&gt;FR03-01 Generate MQL5 code via LLM API&lt;br&gt;FR03-02 Enforce predefined code structure&lt;br&gt;FR03-03 Store generated code with versioning&lt;br&gt;&lt;br&gt;&lt;b&gt;FR04&lt;/b&gt;&lt;br&gt;FR04-01 Compile generated MQL5 scripts&lt;br&gt;FR04-02 Capture compilation errors and logs&lt;br&gt;FR04-03 Iteratively fix errors until success or limit" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=8;fontSize=10;" vertex="1" parent="system">
          <mxGeometry x="40" y="580" width="460" height="880" as="geometry"/>
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;FR05-FR08&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FR05&lt;/b&gt;&lt;br&gt;FR05-01 Execute compiled scripts on historical data&lt;br&gt;FR05-02 Configurable backtesting time ranges&lt;br&gt;FR05-03 Run backtesting in a containerized environment&lt;br&gt;&lt;br&gt;&lt;b&gt;FR06&lt;/b&gt;&lt;br&gt;FR06-01 Extract profit, win rate, drawdown, total trades&lt;br&gt;FR06-02 Calculate risk-reward ratio&lt;br&gt;&lt;br&gt;&lt;b&gt;FR07&lt;/b&gt;&lt;br&gt;FR07-01 Analyze profitability and stability&lt;br&gt;FR07-02 Classify strategy risk level&lt;br&gt;&lt;br&gt;&lt;b&gt;FR08&lt;/b&gt;&lt;br&gt;FR08-01 Refine strategies using evaluation results&lt;br&gt;FR08-02 Regenerate improved strategies iteratively" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=8;fontSize=10;" vertex="1" parent="system">
          <mxGeometry x="560" y="580" width="460" height="880" as="geometry"/>
        </mxCell>
        <mxCell id="note3" value="&lt;b&gt;FR09-FR12&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FR09&lt;/b&gt;&lt;br&gt;FR09-01 Repeat generation, compilation, testing, improvement&lt;br&gt;FR09-02 Stop on acceptable performance or max iterations&lt;br&gt;&lt;br&gt;&lt;b&gt;FR10&lt;/b&gt;&lt;br&gt;FR10-01 Human-readable strategy explanation&lt;br&gt;FR10-02 Highlight risks and assumptions&lt;br&gt;&lt;br&gt;&lt;b&gt;FR11&lt;/b&gt;&lt;br&gt;FR11-01 Store compiled .ex5 files&lt;br&gt;FR11-02 Store performance metrics and analysis&lt;br&gt;&lt;br&gt;&lt;b&gt;FR12&lt;/b&gt;&lt;br&gt;FR12-01 Notify users on completion via webhook or UI" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=8;fontSize=10;" vertex="1" parent="system">
          <mxGeometry x="1080" y="580" width="460" height="880" as="geometry"/>
        </mxCell>
        <mxCell id="note4" value="&lt;b&gt;FR13-FR16&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FR13&lt;/b&gt;&lt;br&gt;FR13-01 Display metrics in a dashboard&lt;br&gt;FR13-02 Visualize profit curve and drawdown&lt;br&gt;&lt;br&gt;&lt;b&gt;FR14&lt;/b&gt;&lt;br&gt;FR14-01 User accepts or requests modification&lt;br&gt;FR14-02 Restart process from user feedback&lt;br&gt;&lt;br&gt;&lt;b&gt;FR15&lt;/b&gt;&lt;br&gt;FR15-01 Include stop-loss and take-profit&lt;br&gt;FR15-02 Enforce capital allocation limits&lt;br&gt;&lt;br&gt;&lt;b&gt;FR16&lt;/b&gt;&lt;br&gt;FR16-01 Support concurrent users with worker-based architecture" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=8;fontSize=10;" vertex="1" parent="system">
